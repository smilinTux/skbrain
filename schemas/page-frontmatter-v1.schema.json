{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/skbrain/schemas/page-frontmatter-v1.schema.json",
  "title": "skbrain page front matter v1",
  "description": "Front matter of a canon page (the EntityNode). Applies to every type except lesson, whose front matter is the vendored skrsi lesson-v1 schema. Consumers normalize YAML dates to YYYY-MM-DD strings before validating.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "namespace", "lifecycle", "title", "created", "updated"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"},
    "type": {"enum": ["runbook", "ci", "service", "node", "known-error", "postmortem", "synthesis"]},
    "namespace": {"const": "ops"},
    "lifecycle": {"enum": ["draft", "reviewed", "canon"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "tags": {
      "description": "Free topic tags.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "lesson_tags": {
      "description": "Keys of the vendored skrsi lesson-tags-v1 vocabulary only. Empty is allowed.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
    },
    "edges": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "type"],
        "properties": {
          "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"},
          "type": {"enum": ["remediates", "touches", "depends_on", "runs_on", "hosts", "connects_to", "documents", "about", "promoted"]}
        }
      }
    },
    "state_refs": {
      "description": "Pointers into operational stores, never state itself.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kedb": {"type": "string", "pattern": "^ke-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "actions": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"enum": ["skrsi-evidence", "skrsi-evaluation", "pr", "incident", "card"]},
          "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@-]{0,199}$"}
        }
      }
    },
    "skrsi_metrics": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "metric"],
        "properties": {
          "target": {"type": "string", "minLength": 1, "maxLength": 100},
          "metric": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "origin": {"enum": ["git", "repo", "itil", "cmdb"]},
    "source_repo": {"type": "string", "maxLength": 200},
    "source_path": {"type": "string", "maxLength": 300},
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
